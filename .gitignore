# Python
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# Node
node_modules/
dist/
build/
*.tsbuildinfo

# Env & secrets（密钥只进环境变量，.env 永不入库）
# 注意：.env.example / .env.test.example 是模板，必须有两条 ! 负向规则放行
# （否则被 .env.* 通配吞掉；CI 的 test_env_templates 守门要读它们）
.env
.env.*
!.env.example
!.env.test.example

# IDE / OS
.idea/
.vscode/
.DS_Store
Thumbs.db

# Logs & local data
*.log
/logs/
/tmp/
/data/

# Project tooling state (local only)
# **/ 形式：任意层级（含 apps/server/.zcode、web/.mimosa 等嵌套目录）都忽略（F11）
**/.zcode/
**/.mimosa/
**/.playwright-mcp/
**/.scratch/

# 本地专用资产（文件保留在磁盘，不上传 GitHub；各自有独立本地 git 仓库）
docs/
design/
out/

# ---- Git 提交规范（2026-10-17 定）：文档/隐秘/非工程文件不入库 ----
# 文档：所有 Markdown 与 README（含根目录 AGENTS.md；docs/design/out 见上）
# 例外：测试代码必须入库（CI 门禁依赖 make test/contracts/test-web，勿对 tests 加 ignore）

# 隐秘信息：密钥/凭证文件格式（.env 系见上节；密钥只进环境变量）
*.pem
*.key
*.p12
*.pfx
secrets.*
*credentials*.json

# 测试产物（测试代码入库，仅产物忽略；Python/Node 缓存见首节）
coverage/
