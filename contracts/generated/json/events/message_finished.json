{
  "$defs": {
    "AgentRef": {
      "additionalProperties": false,
      "description": "事件归属的子智能体标识；envelope.agent 为 null 表示主智能体。\n\n- agent_id：deepagents task() 派生的子线程标识\n- role：general-purpose / explorer / coder / reviewer 或 P1 自定义\n- spawned_by_tool_call_id：派生该子智能体的 task() 工具调用 id —— 前端用它把\n  主流中的 task() 工具卡片与子智能体进度面板（message_delta 兄弟流）关联",
      "properties": {
        "agent_id": {
          "title": "Agent Id",
          "type": "string"
        },
        "parent_agent_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Parent Agent Id"
        },
        "role": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Role"
        },
        "spawned_by_tool_call_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Spawned By Tool Call Id"
        }
      },
      "required": [
        "agent_id"
      ],
      "title": "AgentRef",
      "type": "object"
    },
    "Coverage": {
      "additionalProperties": false,
      "description": "审查覆盖面（扇出场景下部分失败要如实呈现，AC-009-4）。",
      "properties": {
        "files_reviewed": {
          "default": 0,
          "minimum": 0,
          "title": "Files Reviewed",
          "type": "integer"
        },
        "files_skipped": {
          "items": {
            "type": "string"
          },
          "title": "Files Skipped",
          "type": "array"
        },
        "notes": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Notes"
        }
      },
      "title": "Coverage",
      "type": "object"
    },
    "Finding": {
      "additionalProperties": false,
      "description": "单条发现。line/end_line 为 1 起始行号；文件级问题（无行号）两者皆 null。",
      "properties": {
        "category": {
          "enum": [
            "security",
            "correctness",
            "performance",
            "maintainability",
            "style"
          ],
          "title": "Category",
          "type": "string"
        },
        "confidence": {
          "default": "medium",
          "enum": [
            "high",
            "medium",
            "low"
          ],
          "title": "Confidence",
          "type": "string"
        },
        "description": {
          "title": "Description",
          "type": "string"
        },
        "end_line": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "End Line"
        },
        "evidence": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Evidence"
        },
        "file": {
          "title": "File",
          "type": "string"
        },
        "line": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Line"
        },
        "severity": {
          "enum": [
            "critical",
            "high",
            "medium",
            "low",
            "info"
          ],
          "title": "Severity",
          "type": "string"
        },
        "suggestion": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Suggestion"
        },
        "title": {
          "title": "Title",
          "type": "string"
        }
      },
      "required": [
        "file",
        "severity",
        "category",
        "title",
        "description"
      ],
      "title": "Finding",
      "type": "object"
    },
    "ReviewerFindings": {
      "additionalProperties": false,
      "description": "reviewer 子智能体的结构化返回（汇总端机器可拼，AC-011-1）。",
      "properties": {
        "coverage": {
          "anyOf": [
            {
              "$ref": "#/$defs/Coverage"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "findings": {
          "items": {
            "$ref": "#/$defs/Finding"
          },
          "title": "Findings",
          "type": "array"
        },
        "schema_version": {
          "const": "1",
          "default": "1",
          "title": "Schema Version",
          "type": "string"
        },
        "summary": {
          "title": "Summary",
          "type": "string"
        }
      },
      "required": [
        "summary"
      ],
      "title": "ReviewerFindings",
      "type": "object"
    },
    "StructuredResult": {
      "additionalProperties": false,
      "description": "结构化输出附带块（REQ-011）。status=fallback 时 data=null 且前端标注「未结构化」。",
      "properties": {
        "data": {
          "anyOf": [
            {
              "$ref": "#/$defs/ReviewerFindings"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "schema_name": {
          "const": "reviewer_findings",
          "default": "reviewer_findings",
          "title": "Schema Name",
          "type": "string"
        },
        "status": {
          "default": "ok",
          "enum": [
            "ok",
            "fallback"
          ],
          "title": "Status",
          "type": "string"
        }
      },
      "title": "StructuredResult",
      "type": "object"
    },
    "Usage": {
      "additionalProperties": false,
      "description": "token 用量快照。口径（PRD 硬约束 9）：思考系模型的推理 token 计入 output。",
      "properties": {
        "input_tokens": {
          "default": 0,
          "title": "Input Tokens",
          "type": "integer"
        },
        "output_tokens": {
          "default": 0,
          "title": "Output Tokens",
          "type": "integer"
        }
      },
      "title": "Usage",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "assistant 消息收口：finish_reason + 用量 + 可选结构化结果。",
  "properties": {
    "agent": {
      "anyOf": [
        {
          "$ref": "#/$defs/AgentRef"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "finish_reason": {
      "enum": [
        "stop",
        "length",
        "content_filter",
        "error",
        "cancelled"
      ],
      "title": "Finish Reason",
      "type": "string"
    },
    "message_id": {
      "title": "Message Id",
      "type": "string"
    },
    "role": {
      "const": "assistant",
      "default": "assistant",
      "title": "Role",
      "type": "string"
    },
    "run_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Run Id"
    },
    "seq": {
      "description": "会话内单调递增序号；SSE id 即此值",
      "minimum": 0,
      "title": "Seq",
      "type": "integer"
    },
    "session_id": {
      "title": "Session Id",
      "type": "string"
    },
    "structured": {
      "anyOf": [
        {
          "$ref": "#/$defs/StructuredResult"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "type": {
      "const": "message_finished",
      "default": "message_finished",
      "title": "Type",
      "type": "string"
    },
    "usage": {
      "anyOf": [
        {
          "$ref": "#/$defs/Usage"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    }
  },
  "required": [
    "seq",
    "session_id",
    "created_at",
    "message_id",
    "finish_reason"
  ],
  "title": "MessageFinishedEvent",
  "type": "object"
}
