{
  "$defs": {
    "AgentRef": {
      "additionalProperties": false,
      "description": "事件归属的子智能体标识；envelope.agent 为 null 表示主智能体。\n\n- agent_id：deepagents task() 派生的子线程标识\n- role：general-purpose / explorer / coder / reviewer 或 P1 自定义\n- spawned_by_tool_call_id：派生该子智能体的 task() 工具调用 id —— 前端用它把\n  主流中的 task() 工具卡片与子智能体进度面板（message_delta 兄弟流）关联",
      "properties": {
        "agent_id": {
          "title": "Agent Id",
          "type": "string"
        },
        "parent_agent_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Parent Agent Id"
        },
        "role": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Role"
        },
        "spawned_by_tool_call_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Spawned By Tool Call Id"
        }
      },
      "required": [
        "agent_id"
      ],
      "title": "AgentRef",
      "type": "object"
    },
    "ToolErrorObj": {
      "additionalProperties": false,
      "description": "事件侧工具错误对象（tool_call_finished / browser_action）。",
      "properties": {
        "code": {
          "enum": [
            "timeout",
            "sandbox_unavailable",
            "param_invalid",
            "not_found",
            "permission_denied",
            "mcp_transport_error",
            "mcp_tool_error",
            "cancelled",
            "internal"
          ],
          "title": "Code",
          "type": "string"
        },
        "message": {
          "title": "Message",
          "type": "string"
        },
        "retryable": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Retryable"
        }
      },
      "required": [
        "code",
        "message"
      ],
      "title": "ToolErrorObj",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "浏览器动作（REQ-102 / 场景 F）。P1 占位：P0 服务端不得产出本事件；\nschema 先行冻结以稳定契约，前端 P0 不实现消费端。",
  "properties": {
    "action": {
      "title": "Action",
      "type": "string"
    },
    "agent": {
      "anyOf": [
        {
          "$ref": "#/$defs/AgentRef"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "error": {
      "anyOf": [
        {
          "$ref": "#/$defs/ToolErrorObj"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "run_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Run Id"
    },
    "screenshot_ref": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Screenshot Ref"
    },
    "seq": {
      "description": "会话内单调递增序号；SSE id 即此值",
      "minimum": 0,
      "title": "Seq",
      "type": "integer"
    },
    "session_id": {
      "title": "Session Id",
      "type": "string"
    },
    "status": {
      "enum": [
        "started",
        "finished",
        "error"
      ],
      "title": "Status",
      "type": "string"
    },
    "type": {
      "const": "browser_action",
      "default": "browser_action",
      "title": "Type",
      "type": "string"
    },
    "url": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Url"
    }
  },
  "required": [
    "seq",
    "session_id",
    "created_at",
    "action",
    "status"
  ],
  "title": "BrowserActionEvent",
  "type": "object"
}
