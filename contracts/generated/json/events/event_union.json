        "change",
        "additions",
        "deletions"
      ],
      "title": "DiffFileSummary",
      "type": "object"
    },
    "DiffReadyEvent": {
      "additionalProperties": false,
      "description": "diff 就绪（REQ-007）：摘要走事件，逐文件完整 patch 走 REST（patch_ref）。\n\n新建文件须纳入 diff（git add -N 口径，AC-007-1）；totals 与 files 求和一致\n是诚实性强校验（F15：完成态呈现以 diff_ready 事实为准）。",
      "properties": {
        "additions_total": {
          "minimum": 0,
          "title": "Additions Total",
          "type": "integer"
        },
        "agent": {
          "anyOf": [
            {
              "$ref": "#/$defs/AgentRef"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "baseline": {
          "$ref": "#/$defs/BaselineRef"
        },
        "created_at": {
          "format": "date-time",
          "title": "Created At",
          "type": "string"
        },
        "deletions_total": {
          "minimum": 0,
          "title": "Deletions Total",
          "type": "integer"
        },
        "files": {
          "items": {
            "$ref": "#/$defs/DiffFileSummary"
          },
          "minItems": 1,
          "title": "Files",
          "type": "array"
        },
        "patch_ref": {
          "title": "Patch Ref",
          "type": "string"
        },
        "review_id": {
          "title": "Review Id",
          "type": "string"
        },
        "round": {
          "minimum": 1,
          "title": "Round",
          "type": "integer"
        },
        "run_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Run Id"
        },
        "seq": {
          "description": "会话内单调递增序号；SSE id 即此值",
          "minimum": 0,
          "title": "Seq",
          "type": "integer"
        },
        "session_id": {
          "title": "Session Id",
          "type": "string"
        },
        "type": {
          "const": "diff_ready",
          "default": "diff_ready",
          "title": "Type",
          "type": "string"
        }
      },
      "required": [
        "seq",
        "session_id",
        "created_at",
        "review_id",
        "round",
        "baseline",
        "files",
        "additions_total",
        "deletions_total",
        "patch_ref"
      ],
      "title": "DiffReadyEvent",
      "type": "object"
    },
