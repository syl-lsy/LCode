{
  "$defs": {
    "AgentRef": {
      "additionalProperties": false,
      "description": "事件归属的子智能体标识；envelope.agent 为 null 表示主智能体。\n\n- agent_id：deepagents task() 派生的子线程标识\n- role：general-purpose / explorer / coder / reviewer 或 P1 自定义\n- spawned_by_tool_call_id：派生该子智能体的 task() 工具调用 id —— 前端用它把\n  主流中的 task() 工具卡片与子智能体进度面板（message_delta 兄弟流）关联",
      "properties": {
        "agent_id": {
          "title": "Agent Id",
          "type": "string"
        },
        "parent_agent_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Parent Agent Id"
        },
        "role": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Role"
        },
        "spawned_by_tool_call_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Spawned By Tool Call Id"
        }
      },
      "required": [
        "agent_id"
      ],
      "title": "AgentRef",
      "type": "object"
    },
    "ApprovalRequestEvent": {
      "additionalProperties": false,
      "description": "审批请求（REQ-006）：四决策 approve/edit/reject/respond 经 REST 决策端点提交。\n\n不超时自动放行（AC-006-5）：本事件无过期语义；挂起态跨刷新由 approvals 表恢复。",
      "properties": {
        "agent": {
          "anyOf": [
            {
              "$ref": "#/$defs/AgentRef"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "approval_id": {
          "title": "Approval Id",
          "type": "string"
        },
        "args": {
          "additionalProperties": true,
          "title": "Args",
          "type": "object"
        },
        "created_at": {
          "format": "date-time",
          "title": "Created At",
          "type": "string"
        },
        "reason": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Reason"
        },
        "risk_level": {
          "enum": [
            "medium",
            "high"
          ],
          "title": "Risk Level",
          "type": "string"
        },
        "run_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Run Id"
        },
        "seq": {
          "description": "会话内单调递增序号；SSE id 即此值",
          "minimum": 0,
          "title": "Seq",
          "type": "integer"
        },
        "session_id": {
          "title": "Session Id",
          "type": "string"
        },
        "tool": {
          "title": "Tool",
          "type": "string"
        },
        "tool_call_id": {
          "title": "Tool Call Id",
          "type": "string"
        },
        "type": {
          "const": "approval_request",
          "default": "approval_request",
          "title": "Type",
          "type": "string"
        }
      },
      "required": [
        "seq",
        "session_id",
        "created_at",
        "approval_id",
        "tool_call_id",
        "tool",
        "args",
        "risk_level"
      ],
      "title": "ApprovalRequestEvent",
      "type": "object"
    },
    "ApprovalResolvedEvent": {
      "additionalProperties": false,
      "description": "审批决策回声（决策经 POST /approvals/{id}/decide 落库后广播）。\n\n用途：多标签页一致 + 纯事件回放可重建审批卡片终态（AC-008-3/AC-004-4）。",
      "properties": {
        "agent": {
          "anyOf": [
            {
              "$ref": "#/$defs/AgentRef"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "approval_id": {
          "title": "Approval Id",
          "type": "string"
        },
        "created_at": {
          "format": "date-time",
          "title": "Created At",
          "type": "string"
        },
        "decided_by": {
          "title": "Decided By",
          "type": "string"
        },
        "decision": {
          "enum": [
            "approve",
            "edit",
            "reject",
            "respond"
          ],
          "title": "Decision",
          "type": "string"
        },
        "edited_args": {
          "anyOf": [
            {
              "additionalProperties": true,
              "type": "object"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Edited Args"
        },
        "feedback": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Feedback"
        },
        "run_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Run Id"
        },
        "scope": {
          "default": "once",
          "enum": [
            "once",
            "session"
          ],
          "title": "Scope",
          "type": "string"
        },
        "seq": {
          "description": "会话内单调递增序号；SSE id 即此值",
          "minimum": 0,
          "title": "Seq",
          "type": "integer"
        },
        "session_id": {
          "title": "Session Id",
          "type": "string"
        },
        "type": {
          "const": "approval_resolved",
          "default": "approval_resolved",
          "title": "Type",
          "type": "string"
        }
      },
      "required": [
        "seq",
        "session_id",
        "created_at",
        "approval_id",
        "decision",
        "decided_by"
      ],
      "title": "ApprovalResolvedEvent",
      "type": "object"
    },
    "BaselineRef": {
      "additionalProperties": false,
      "description": "diff 对照基线引用（REQ-007 / AC-007-1/4）。\n\nkind 语义：head=输入仓库自身历史（不做 git 操作）；init=非 git 输入的\n[lcode-baseline] 初始提交（round-0）；accepted=上轮已接受后创建的基线提交。",
      "properties": {
        "commit": {
          "pattern": "^[0-9a-f]{40}$",
          "title": "Commit",
          "type": "string"
        },
        "kind": {
          "enum": [
            "head",
            "init",
            "accepted"
          ],
          "title": "Kind",
          "type": "string"
        },
        "ref": {
          "title": "Ref",
          "type": "string"
        }
      },
      "required": [
        "kind",
        "ref",
        "commit"
      ],
      "title": "BaselineRef",
      "type": "object"
    },
    "BrowserActionEvent": {
      "additionalProperties": false,
      "description": "浏览器动作（REQ-102 / 场景 F）。P1 占位：P0 服务端不得产出本事件；\nschema 先行冻结以稳定契约，前端 P0 不实现消费端。",
      "properties": {
        "action": {
          "title": "Action",
          "type": "string"
        },
        "agent": {
          "anyOf": [
            {
              "$ref": "#/$defs/AgentRef"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "created_at": {
          "format": "date-time",
          "title": "Created At",
          "type": "string"
        },
        "error": {
          "anyOf": [
            {
              "$ref": "#/$defs/ToolErrorObj"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "run_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Run Id"
        },
        "screenshot_ref": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Screenshot Ref"
        },
        "seq": {
          "description": "会话内单调递增序号；SSE id 即此值",
          "minimum": 0,
          "title": "Seq",
          "type": "integer"
        },
        "session_id": {
          "title": "Session Id",
          "type": "string"
        },
        "status": {
          "enum": [
            "started",
            "finished",
            "error"
          ],
          "title": "Status",
          "type": "string"
        },
        "type": {
          "const": "browser_action",
          "default": "browser_action",
          "title": "Type",
          "type": "string"
        },
        "url": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Url"
        }
      },
      "required": [
        "seq",
        "session_id",
        "created_at",
        "action",
        "status"
      ],
      "title": "BrowserActionEvent",
      "type": "object"
    },
    "CompactInfo": {
      "additionalProperties": false,
      "description": "上下文压缩前后窗口占用（REQ-010 / AC-010-1 界面提示）。",
      "properties": {
