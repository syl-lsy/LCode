{
  "$defs": {
    "AgentRef": {
      "additionalProperties": false,
      "description": "事件归属的子智能体标识；envelope.agent 为 null 表示主智能体。\n\n- agent_id：deepagents task() 派生的子线程标识\n- role：general-purpose / explorer / coder / reviewer 或 P1 自定义\n- spawned_by_tool_call_id：派生该子智能体的 task() 工具调用 id —— 前端用它把\n  主流中的 task() 工具卡片与子智能体进度面板（message_delta 兄弟流）关联",
      "properties": {
        "agent_id": {
          "title": "Agent Id",
          "type": "string"
        },
        "parent_agent_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Parent Agent Id"
        },
        "role": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Role"
        },
        "spawned_by_tool_call_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Spawned By Tool Call Id"
        }
      },
      "required": [
        "agent_id"
      ],
      "title": "AgentRef",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "审批决策回声（决策经 POST /approvals/{id}/decide 落库后广播）。\n\n用途：多标签页一致 + 纯事件回放可重建审批卡片终态（AC-008-3/AC-004-4）。",
  "properties": {
    "agent": {
      "anyOf": [
        {
          "$ref": "#/$defs/AgentRef"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "approval_id": {
      "title": "Approval Id",
      "type": "string"
    },
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "decided_by": {
      "title": "Decided By",
      "type": "string"
    },
    "decision": {
      "enum": [
        "approve",
        "edit",
        "reject",
        "respond"
      ],
      "title": "Decision",
      "type": "string"
    },
    "edited_args": {
      "anyOf": [
        {
          "additionalProperties": true,
          "type": "object"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Edited Args"
    },
    "feedback": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Feedback"
    },
    "run_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Run Id"
    },
    "scope": {
      "default": "once",
      "enum": [
        "once",
        "session"
      ],
      "title": "Scope",
      "type": "string"
    },
    "seq": {
      "description": "会话内单调递增序号；SSE id 即此值",
      "minimum": 0,
      "title": "Seq",
      "type": "integer"
    },
    "session_id": {
      "title": "Session Id",
      "type": "string"
    },
    "type": {
      "const": "approval_resolved",
      "default": "approval_resolved",
      "title": "Type",
      "type": "string"
    }
  },
  "required": [
    "seq",
    "session_id",
    "created_at",
    "approval_id",
    "decision",
    "decided_by"
  ],
  "title": "ApprovalResolvedEvent",
  "type": "object"
}
