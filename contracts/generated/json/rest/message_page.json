{
  "$defs": {
    "Coverage": {
      "additionalProperties": false,
      "description": "审查覆盖面（扇出场景下部分失败要如实呈现，AC-009-4）。",
      "properties": {
        "files_reviewed": {
          "default": 0,
          "minimum": 0,
          "title": "Files Reviewed",
          "type": "integer"
        },
        "files_skipped": {
          "items": {
            "type": "string"
          },
          "title": "Files Skipped",
          "type": "array"
        },
        "notes": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Notes"
        }
      },
      "title": "Coverage",
      "type": "object"
    },
    "Finding": {
      "additionalProperties": false,
      "description": "单条发现。line/end_line 为 1 起始行号；文件级问题（无行号）两者皆 null。",
      "properties": {
        "category": {
          "enum": [
            "security",
            "correctness",
            "performance",
            "maintainability",
            "style"
          ],
          "title": "Category",
          "type": "string"
        },
        "confidence": {
          "default": "medium",
          "enum": [
            "high",
            "medium",
            "low"
          ],
          "title": "Confidence",
          "type": "string"
        },
        "description": {
          "title": "Description",
          "type": "string"
        },
        "end_line": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "End Line"
        },
        "evidence": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Evidence"
        },
        "file": {
          "title": "File",
          "type": "string"
        },
        "line": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Line"
        },
        "severity": {
          "enum": [
            "critical",
            "high",
            "medium",
            "low",
            "info"
          ],
          "title": "Severity",
          "type": "string"
        },
        "suggestion": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Suggestion"
        },
        "title": {
          "title": "Title",
          "type": "string"
        }
      },
      "required": [
        "file",
        "severity",
        "category",
        "title",
        "description"
      ],
      "title": "Finding",
      "type": "object"
    },
    "MessageItem": {
      "additionalProperties": false,
      "description": "消息历史投影（GET /sessions/{id}/messages，供导出/检索；面板重建走事件流）。\n\n不含 thinking：历史导出不携带思考内容（回放路径有——message_delta(kind=thinking)\n事件流；messages 表 thinking 列仍照常落库），本投影取最小面。",
      "properties": {
        "agent_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Agent Id"
        },
        "content": {
          "title": "Content",
          "type": "string"
        },
        "created_at": {
          "format": "date-time",
          "title": "Created At",
          "type": "string"
        },
        "finish_reason": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Finish Reason"
        },
        "id": {
          "title": "Id",
          "type": "string"
        },
        "role": {
          "enum": [
            "user",
            "assistant"
          ],
          "title": "Role",
          "type": "string"
        },
        "run_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Run Id"
        },
        "structured": {
          "anyOf": [
            {
              "$ref": "#/$defs/StructuredResult"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "id",
        "role",
        "content",
        "created_at"
      ],
      "title": "MessageItem",
      "type": "object"
    },
    "ReviewerFindings": {
      "additionalProperties": false,
      "description": "reviewer 子智能体的结构化返回（汇总端机器可拼，AC-011-1）。",
      "properties": {
        "coverage": {
          "anyOf": [
            {
              "$ref": "#/$defs/Coverage"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "findings": {
          "items": {
            "$ref": "#/$defs/Finding"
          },
          "title": "Findings",
          "type": "array"
        },
        "schema_version": {
          "const": "1",
          "default": "1",
          "title": "Schema Version",
          "type": "string"
        },
        "summary": {
          "title": "Summary",
          "type": "string"
        }
      },
      "required": [
        "summary"
      ],
      "title": "ReviewerFindings",
      "type": "object"
    },
    "StructuredResult": {
      "additionalProperties": false,
      "description": "结构化输出附带块（REQ-011）。status=fallback 时 data=null 且前端标注「未结构化」。",
      "properties": {
        "data": {
          "anyOf": [
            {
              "$ref": "#/$defs/ReviewerFindings"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "schema_name": {
          "const": "reviewer_findings",
          "default": "reviewer_findings",
          "title": "Schema Name",
          "type": "string"
        },
        "status": {
          "default": "ok",
          "enum": [
            "ok",
            "fallback"
          ],
          "title": "Status",
          "type": "string"
        }
      },
      "title": "StructuredResult",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "items": {
      "items": {
        "$ref": "#/$defs/MessageItem"
      },
      "title": "Items",
      "type": "array"
    },
    "next_cursor": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Next Cursor"
    }
  },
  "required": [
    "items"
  ],
  "title": "MessagePage",
  "type": "object"
}
