{
  "$defs": {
    "ApprovalItem": {
      "additionalProperties": false,
      "description": "审批行投影（GET /approvals 列表/详情；与 approvals 表逐值对应）。\n\n- status 含 auto_approved：AUTO 模式分类器决策的落行（decided_by='classifier'，\n  审计面见 contracts/README「表规格补充语义」/ REQ-013 AC-013-3）；\n- reason：命中哪条规则/分类器理由——pending 卡片恢复（AC-006-5）必须展示，\n  故进 REST 投影；\n- 其余决策载荷（edited_args/feedback）以 approval_resolved 事件回放为准，\n  不重复投影（列表仅承载卡片恢复与筛选所需字段）。",
      "properties": {
        "args": {
          "additionalProperties": true,
          "title": "Args",
          "type": "object"
        },
        "created_at": {
          "format": "date-time",
          "title": "Created At",
          "type": "string"
        },
        "decided_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Decided At"
        },
        "decision": {
          "anyOf": [
            {
              "enum": [
                "approve",
                "edit",
                "reject",
                "respond"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Decision"
        },
        "id": {
          "title": "Id",
          "type": "string"
        },
        "reason": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Reason"
        },
        "risk_level": {
          "enum": [
            "medium",
            "high"
          ],
          "title": "Risk Level",
          "type": "string"
        },
        "scope": {
          "default": "once",
          "enum": [
            "once",
            "session"
          ],
          "title": "Scope",
          "type": "string"
        },
        "session_id": {
          "title": "Session Id",
          "type": "string"
        },
        "status": {
          "enum": [
            "pending",
            "approved",
            "rejected",
            "edited",
            "responded",
            "auto_approved"
          ],
          "title": "Status",
          "type": "string"
        },
        "tool": {
          "title": "Tool",
          "type": "string"
        }
      },
      "required": [
        "id",
        "session_id",
        "tool",
        "args",
        "risk_level",
        "status",
        "created_at"
      ],
      "title": "ApprovalItem",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "items": {
      "items": {
        "$ref": "#/$defs/ApprovalItem"
      },
      "title": "Items",
      "type": "array"
    },
    "next_cursor": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Next Cursor"
    }
  },
  "required": [
    "items"
  ],
  "title": "ApprovalPage",
  "type": "object"
}
