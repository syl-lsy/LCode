{
  "$defs": {
    "Coverage": {
      "additionalProperties": false,
      "description": "审查覆盖面（扇出场景下部分失败要如实呈现，AC-009-4）。",
      "properties": {
        "files_reviewed": {
          "default": 0,
          "minimum": 0,
          "title": "Files Reviewed",
          "type": "integer"
        },
        "files_skipped": {
          "items": {
            "type": "string"
          },
          "title": "Files Skipped",
          "type": "array"
        },
        "notes": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Notes"
        }
      },
      "title": "Coverage",
      "type": "object"
    },
    "Finding": {
      "additionalProperties": false,
      "description": "单条发现。line/end_line 为 1 起始行号；文件级问题（无行号）两者皆 null。",
      "properties": {
        "category": {
          "enum": [
            "security",
            "correctness",
            "performance",
            "maintainability",
            "style"
          ],
          "title": "Category",
          "type": "string"
        },
        "confidence": {
          "default": "medium",
          "enum": [
            "high",
            "medium",
            "low"
          ],
          "title": "Confidence",
          "type": "string"
        },
        "description": {
          "title": "Description",
          "type": "string"
        },
        "end_line": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "End Line"
        },
        "evidence": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Evidence"
        },
        "file": {
          "title": "File",
          "type": "string"
        },
        "line": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Line"
        },
        "severity": {
          "enum": [
            "critical",
            "high",
            "medium",
            "low",
            "info"
          ],
          "title": "Severity",
          "type": "string"
        },
        "suggestion": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Suggestion"
        },
        "title": {
          "title": "Title",
          "type": "string"
        }
      },
      "required": [
        "file",
        "severity",
        "category",
        "title",
        "description"
      ],
      "title": "Finding",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "reviewer 子智能体的结构化返回（汇总端机器可拼，AC-011-1）。",
  "properties": {
    "coverage": {
      "anyOf": [
        {
          "$ref": "#/$defs/Coverage"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "findings": {
      "items": {
        "$ref": "#/$defs/Finding"
      },
      "title": "Findings",
      "type": "array"
    },
    "schema_version": {
      "const": "1",
      "default": "1",
      "title": "Schema Version",
      "type": "string"
    },
    "summary": {
      "title": "Summary",
      "type": "string"
    }
  },
  "required": [
    "summary"
  ],
  "title": "ReviewerFindings",
  "type": "object"
}
