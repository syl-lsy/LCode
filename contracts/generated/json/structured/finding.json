{
  "additionalProperties": false,
  "description": "单条发现。line/end_line 为 1 起始行号；文件级问题（无行号）两者皆 null。",
  "properties": {
    "category": {
      "enum": [
        "security",
        "correctness",
        "performance",
        "maintainability",
        "style"
      ],
      "title": "Category",
      "type": "string"
    },
    "confidence": {
      "default": "medium",
      "enum": [
        "high",
        "medium",
        "low"
      ],
      "title": "Confidence",
      "type": "string"
    },
    "description": {
      "title": "Description",
      "type": "string"
    },
    "end_line": {
      "anyOf": [
        {
          "minimum": 1,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "End Line"
    },
    "evidence": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Evidence"
    },
    "file": {
      "title": "File",
      "type": "string"
    },
    "line": {
      "anyOf": [
        {
          "minimum": 1,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Line"
    },
    "severity": {
      "enum": [
        "critical",
        "high",
        "medium",
        "low",
        "info"
      ],
      "title": "Severity",
      "type": "string"
    },
    "suggestion": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Suggestion"
    },
    "title": {
      "title": "Title",
      "type": "string"
    }
  },
  "required": [
    "file",
    "severity",
    "category",
    "title",
    "description"
  ],
  "title": "Finding",
  "type": "object"
}
