# LCode 环境变量模板（cp .env.example .env 后按需填写；.env 不入库——见根 .gitignore）
#
# 口径（A3 §2.1 / 基座铁律 1/5）：
# - 变量清单与 apps/server/app/core/config.py 的字段**逐项对齐**（前缀即分组）；
# - **密钥本体只进 .env，绝不入库**：LLM_/SANDBOX_ 组只写「密钥所在环境变量的名字」
#   （*_API_KEY_ENV 引用模式，NFR-004），值本身另行 export 或用本机密钥管理注入。

# ===== 通用（无前缀）=====
ENVIRONMENT=development

# ===== WEB_：服务监听地址与展示名 =====
# 值含空格时必须加引号：uv 的 `--env-file` 解析器要求引号（裸空格会解析失败）
WEB_APP_NAME=
WEB_HOST=
WEB_PORT=

# ===== DB_：PostgreSQL（业务十表 + LangGraph checkpointer 同实例）=====
DB_HOST=
DB_PORT=
DB_NAME=
DB_USER=
DB_PASSWORD=
DB_POOL_SIZE=
DB_MAX_OVERFLOW=
DB_ECHO=

# ===== LLM_：Anthropic Messages 兼容网关（ADR-007：ChatAnthropic，保留 thinking/signature）=====
# LLM_BASE_URL 填 Anthropic base URL（/v1/messages 端点的网关地址）；OpenAI-only 网关不支持
# LLM_API_KEY_ENV 是「网关密钥所在的环境变量名」，不是密钥本体（值形如 DASHSCOPE_API_KEY）
LLM_BASE_URL=
LLM_API_KEY_ENV=DASHSCOPE_API_KEY
LLM_REQUEST_TIMEOUT_S=300
LLM_MAX_RETRIES=2

# ===== SANDBOX_：沙箱 provider 与计费口径 =====
SANDBOX_PROVIDER=
# diff 工作区（D7）：留空 = 沙箱默认 cwd；填绝对路径则以其为 repo root 解析起点
SANDBOX_WORKSPACE_DIR=
SANDBOX_IDLE_PAUSE_SECONDS=
SANDBOX_COST_RATE_PER_HOUR=
SANDBOX_PAUSED_RATE_PER_GIB_HOUR=
# 百炼（E2B 协议）：密钥引用名 + 镜像模板 + E2B 接入完整地址（模板/地址待 M2 spike 定，U5）
SANDBOX_BAILIAN_API_KEY_ENV=
SANDBOX_BAILIAN_TEMPLATE=
# 完整 URL 形态：https://{workspace_id}.{region}.maas.aliyuncs.com/api/v1/agentstudio/sandbox
SANDBOX_BAILIAN_API_URL=
# 仅用于拼 e2b_<uid> 形态的 api_key 占位符（百炼不做业务鉴权，真实鉴权走 Authorization 头）；可空
SANDBOX_BAILIAN_ALIYUN_UID=
# OpenSandbox（自托管备选）：endpoint 按实际部署填写，backend 本地 macOS 退化为 docker
SANDBOX_OPENSANDBOX_ENDPOINT=
SANDBOX_OPENSANDBOX_API_KEY_ENV=OPENSANDBOX_API_KEY
SANDBOX_OPENSANDBOX_BACKEND=docker
# OpenSandbox 镜像（SDK 要求 image 或 snapshot_id；本适配器不支持 snapshot；留空=未配置，create 时 fail-fast）
SANDBOX_OPENSANDBOX_IMAGE=

# ===== SSE_：事件流传输参数 =====
SSE_RETRY_MS=3000
SSE_HEARTBEAT_SECONDS=15
SSE_SUBSCRIBER_QUEUE=1000

# ===== AGENT_：编排运行时参数 =====
AGENT_MAX_PARALLEL_FANOUT=8
AGENT_RUN_TIMEOUT_S=3600
# 断点恢复 saver 后端（REQ-004）：postgres=真库 AsyncPostgresSaver（审批 interrupt 跨进程恢复）；
# memory=进程内 InMemorySaver（测试/无库轻量部署）；e2e 另有 LCODE_E2E_CHECKPOINTER 强制口。
AGENT_CHECKPOINTER=postgres

# AUTO 审批分类器（REQ-013 AC-013-3）：rules=确定性规则（零网络，默认）；
# llm=走经济档模型（角色 approval_classifier）。超时/畸形/异常一律 fail-closed 转人工。
AGENT_AUTO_APPROVAL_CLASSIFIER=rules
AGENT_AUTO_APPROVAL_TIMEOUT_S=8

# ===== LOG_：统一日志体系（app/core/logger/，基座铁律 11 / NFR-007）=====
LOG_LEVEL=INFO                 # 输出级别（TRACE/DEBUG/INFO/SUCCESS/WARNING/ERROR/CRITICAL）
LOG_SLOW_QUERY_THRESHOLD=200   # 毫秒：SQL 执行超过该阈值记慢查询 warning
LOG_FILE_DIR=logs              # dev 环境 ERROR 日志目录（相对仓库根；production 只走 stdout）
