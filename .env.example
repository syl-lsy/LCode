# LCode 环境变量模板（cp .env.example .env 后按需填写；.env 不入库——见根 .gitignore）
#
# 口径（A3 §2.1 / 基座铁律 1/5）：
# - 变量清单与 apps/server/app/core/config.py 的字段**逐项对齐**（前缀即分组）；
# - **密钥本体只进 .env，绝不入库**：LLM_/SANDBOX_ 组只写「密钥所在环境变量的名字」
#   （*_API_KEY_ENV 引用模式，NFR-004），值本身另行 export 或用本机密钥管理注入。

# ===== 通用（无前缀）=====
ENVIRONMENT=development
LOG_LEVEL=INFO

# ===== WEB_：服务监听地址与展示名 =====
# 值含空格时必须加引号：uv 的 `--env-file` 解析器要求引号（裸空格会解析失败）
WEB_APP_NAME=
WEB_HOST=
WEB_PORT=

# ===== DB_：PostgreSQL（业务十表 + LangGraph checkpointer 同实例）=====
DB_HOST=
DB_PORT=
DB_NAME=
DB_USER=
DB_PASSWORD=
DB_POOL_SIZE=
DB_MAX_OVERFLOW=
DB_ECHO=

# ===== LLM_：OpenAI 兼容网关 =====
# LLM_API_KEY_ENV 是「网关密钥所在的环境变量名」，不是密钥本体（值形如 DASHSCOPE_API_KEY）
LLM_BASE_URL=
LLM_API_KEY_ENV=DASHSCOPE_API_KEY
LLM_REQUEST_TIMEOUT_S=300
LLM_MAX_RETRIES=2

# ===== SANDBOX_：沙箱 provider 与计费口径 =====
SANDBOX_PROVIDER=
SANDBOX_IDLE_PAUSE_SECONDS=
SANDBOX_COST_RATE_PER_HOUR=
SANDBOX_PAUSED_RATE_PER_GIB_HOUR=
# 百炼（E2B 协议）：密钥引用名 + 镜像模板/域名（模板与域名待 M2 spike 定，U5）
SANDBOX_BAILIAN_API_KEY_ENV=
SANDBOX_BAILIAN_TEMPLATE=
SANDBOX_BAILIAN_DOMAIN=
# OpenSandbox（自托管备选）：endpoint 按实际部署填写，backend 本地 macOS 退化为 docker
SANDBOX_OPENSANDBOX_ENDPOINT=
SANDBOX_OPENSANDBOX_API_KEY_ENV=OPENSANDBOX_API_KEY
SANDBOX_OPENSANDBOX_BACKEND=docker

# ===== SSE_：事件流传输参数 =====
SSE_RETRY_MS=3000
SSE_HEARTBEAT_SECONDS=15
SSE_SUBSCRIBER_QUEUE=1000

# ===== AGENT_：编排运行时参数 =====
AGENT_MAX_PARALLEL_FANOUT=8
AGENT_RUN_TIMEOUT_S=3600
