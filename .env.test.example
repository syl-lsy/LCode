# LCode 测试环境变量模板（cp .env.test.example .env.test；.env.test 不入库）
#
# 口径（基座 testing.md 第一节）：integration / e2e 层读取本文件；真实外部依赖
# （PostgreSQL / 百炼沙箱 / 真实 LLM）缺失时测试用 requires_* 标记**按需跳过**，
# 不让整条命令红掉。变量清单与 .env.example 同源（同 config.py 字段），
# 只把「库名 / 环境标识」换成测试值。

# ===== 通用（无前缀）=====
ENVIRONMENT=test

# ===== WEB_ =====
WEB_APP_NAME="LCode Server API (test)"
WEB_HOST=127.0.0.1
# 骨架期**未被消费**：服务端口由启动命令决定（`fastapi dev --port ...`），
# e2e 子进程端口硬编码 18000（apps/server/test/e2e/conftest.py）——此处取同值仅为
# 避免与真实端口不一致造成误读；M2 若要「配置驱动端口」需先让启动命令读本变量。
WEB_PORT=18000

# ===== DB_：测试库（integration 的 conftest 会重建本库并跑 alembic upgrade head）=====
DB_HOST=localhost
DB_PORT=5432
DB_NAME=lcode_test
DB_USER=lcode
DB_PASSWORD=
DB_POOL_SIZE=2
DB_MAX_OVERFLOW=5
DB_ECHO=false

# ===== LLM_：集成测试默认不起真模型（假模型/剧本化回复）；真网关冒烟单列 requires_llm =====
# LLM_BASE_URL 为 Anthropic Messages 兼容网关地址（/v1/messages 端点，ADR-007）
LLM_BASE_URL=
LLM_API_KEY_ENV=DASHSCOPE_API_KEY
LLM_REQUEST_TIMEOUT_S=60
LLM_MAX_RETRIES=0

# ===== SANDBOX_：真沙箱冒烟单列 requires_sandbox（缺凭证跳过）=====
SANDBOX_PROVIDER=bailian
# diff 工作区：测试走 FakeSandbox（tmp 目录），留空 = 沙箱默认 cwd
SANDBOX_WORKSPACE_DIR=
SANDBOX_IDLE_PAUSE_SECONDS=120
SANDBOX_COST_RATE_PER_HOUR=0.156
SANDBOX_PAUSED_RATE_PER_GIB_HOUR=0.0021
SANDBOX_BAILIAN_API_KEY_ENV=BAILIAN_API_KEY
SANDBOX_BAILIAN_TEMPLATE=
# 百炼 E2B 接入完整地址：https://{workspace_id}.{region}.maas.aliyuncs.com/api/v1/agentstudio/sandbox
SANDBOX_BAILIAN_API_URL=
# api_key 占位符用的 aliyun uid（可空；百炼不做业务鉴权）
SANDBOX_BAILIAN_ALIYUN_UID=
SANDBOX_OPENSANDBOX_ENDPOINT=
SANDBOX_OPENSANDBOX_API_KEY_ENV=OPENSANDBOX_API_KEY
SANDBOX_OPENSANDBOX_BACKEND=docker
# OpenSandbox 镜像（SDK 要求 image 或 snapshot_id；本适配器不支持 snapshot；留空=未配置，冒烟跳过）
SANDBOX_OPENSANDBOX_IMAGE=

# ===== SSE_（e2e 缩短心跳与退避，加快用例）=====
SSE_RETRY_MS=1000
SSE_HEARTBEAT_SECONDS=3
SSE_SUBSCRIBER_QUEUE=100

# ===== AGENT_ =====
AGENT_MAX_PARALLEL_FANOUT=4
AGENT_RUN_TIMEOUT_S=120
# integration / unit 车道用进程内 saver（零副作用）；e2e 子进程由
# LCODE_E2E_CHECKPOINTER=postgres 覆盖（真库 AsyncPostgresSaver，见下方 e2e 开关）。
AGENT_CHECKPOINTER=memory

# AUTO 分类器固定 rules：测试零网络、零凭证（AGENT_AUTO_APPROVAL_CLASSIFIER 的 llm 档
# 由 unit 假模型覆盖）。
AGENT_AUTO_APPROVAL_CLASSIFIER=rules
AGENT_AUTO_APPROVAL_TIMEOUT_S=2

# ===== LOG_：测试进程与 e2e 子进程共用；LOG_FILE_DIR 指向 tmp/logs =====
# （测试故意触发异常（INTERNAL/500 兜底等），错误日志不写进仓库根；tmp/ 已 gitignore）
LOG_LEVEL=INFO
LOG_SLOW_QUERY_THRESHOLD=200
LOG_FILE_DIR=tmp/logs

# ===== e2e 专用开关（仅测试车道；不进 wire 契约、不进生产 .env.example，test-plan §3.1/§6-5）=====
# 由 apps/server/test/e2e/conftest.py 注入服务子进程、在装配面读取（test/e2e/server_entry.py
# 与 app/core/postgres_checkpointer.py）；生产 .env 不设这些变量，行为零改动。
#   LCODE_E2E_FAKE_LLM=1              进程内 ScriptedChatModel 剧本路由假模型
#   LCODE_E2E_FAKE_SANDBOX=1          进程内 FakeSandbox（本地 tmp + 真子进程）
#   LCODE_E2E_CHECKPOINTER=postgres   真 AsyncPostgresSaver（REQ-004 约束④，lifespan 装配）
# e2e 测试库固定 lcode_e2e_test（conftest 覆盖 DB_NAME，独立于 integration 的 lcode_test）。
